{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cardforge.dev/schemas/v2.schema.json",
  "title": "CardForge Document v2",
  "type": "object",
  "required": ["cardforge", "meta", "object", "materials", "faces"],
  "additionalProperties": false,
  "properties": {
    "cardforge": { "const": "2.0" },
    "meta": {
      "type": "object",
      "required": ["id", "name"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "created": { "type": "string" },
        "modified": { "type": "string" }
      }
    },
    "object": {
      "type": "object",
      "required": ["outline", "thickness"],
      "additionalProperties": false,
      "properties": {
        "outline": { "$ref": "#/$defs/outline" },
        "thickness": { "type": "number", "exclusiveMinimum": 0 },
        "fill": { "$ref": "#/$defs/fill" }
      }
    },
    "materials": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/material" }
    },
    "variables": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "assets": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "manufacturing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "process": { "enum": ["fdm", "sla", "laser", "cnc"] },
        "profile": { "type": "string" },
        "nozzle": { "type": "number", "exclusiveMinimum": 0 },
        "layerHeight": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "faces": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "front": { "$ref": "#/$defs/face" },
        "back": { "$ref": "#/$defs/face" }
      }
    }
  },
  "$defs": {
    "outline": {
      "oneOf": [
        {
          "type": "object",
          "required": ["type", "width", "height"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "rect" },
            "width": { "type": "number", "exclusiveMinimum": 0 },
            "height": { "type": "number", "exclusiveMinimum": 0 }
          }
        },
        {
          "type": "object",
          "required": ["type", "width", "height", "radius"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "rounded-rect" },
            "width": { "type": "number", "exclusiveMinimum": 0 },
            "height": { "type": "number", "exclusiveMinimum": 0 },
            "radius": { "type": "number", "minimum": 0 },
            "corners": {
              "type": "object",
              "additionalProperties": false,
              "description": "Per-corner radii; missing corners fall back to radius.",
              "properties": {
                "tl": { "type": "number", "minimum": 0 },
                "tr": { "type": "number", "minimum": 0 },
                "br": { "type": "number", "minimum": 0 },
                "bl": { "type": "number", "minimum": 0 }
              }
            }
          }
        },
        {
          "type": "object",
          "required": ["type", "diameter"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "circle" },
            "diameter": { "type": "number", "exclusiveMinimum": 0 }
          }
        },
        {
          "type": "object",
          "required": ["type", "width", "height"],
          "additionalProperties": false,
          "anyOf": [
            { "required": ["svgPath"], "properties": { "svgPath": { "minLength": 1 } } },
            { "required": ["svgInline"], "properties": { "svgInline": { "minLength": 1 } } }
          ],
          "properties": {
            "type": { "const": "path" },
            "svgPath": { "type": "string" },
            "svgInline": { "type": "string" },
            "colorMap": { "type": "object", "additionalProperties": { "type": "string" } },
            "colorDepth": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "Depth (mm) of the multicolor layer, measured from the coloured face. Omitted = the colors run through the full thickness."
            },
            "colorFace": {
              "enum": ["front", "back", "both"],
              "description": "Which face the colors are visible on. Only meaningful with colorDepth."
            },
            "width": { "type": "number", "exclusiveMinimum": 0 },
            "height": { "type": "number", "exclusiveMinimum": 0 }
          }
        }
      ]
    },
    "material": {
      "type": "object",
      "required": ["id", "name", "color"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "slot": { "type": "integer", "minimum": 1 },
        "role": { "enum": ["base", "text", "accent", "detail", "support"] }
      }
    },
    "face": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "features": {
          "type": "array",
          "items": { "$ref": "#/$defs/feature" }
        }
      }
    },
    "fill": {
      "oneOf": [
        {
          "type": "object",
          "required": ["type"],
          "additionalProperties": false,
          "properties": { "type": { "const": "solid" } }
        },
        {
          "type": "object",
          "required": ["type", "pattern", "spacing"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "lattice" },
            "pattern": { "enum": ["dots", "lines", "grid", "hex"] },
            "spacing": { "type": "number", "exclusiveMinimum": 0 },
            "lineWidth": { "type": "number", "exclusiveMinimum": 0 },
            "border": { "type": "number", "minimum": 0 }
          }
        }
      ]
    },
    "backing": {
      "type": "object",
      "required": ["mode"],
      "additionalProperties": false,
      "description": "Support pad so a feature isn't left floating (esp. over a lattice).",
      "properties": {
        "mode": { "enum": ["auto", "on", "off"] },
        "thickness": { "type": "number", "exclusiveMinimum": 0 },
        "material": { "type": "string", "minLength": 1 },
        "padding": { "type": "number", "minimum": 0 },
        "shape": { "enum": ["rect", "circle"] }
      }
    },
    "transform": {
      "type": "object",
      "required": ["x", "y"],
      "additionalProperties": false,
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "rotation": { "type": "number" },
        "scale": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "relief": {
      "oneOf": [
        {
          "type": "object",
          "required": ["mode", "height"],
          "additionalProperties": false,
          "properties": {
            "mode": { "const": "emboss" },
            "height": { "type": "number", "exclusiveMinimum": 0 }
          }
        },
        {
          "type": "object",
          "required": ["mode", "depth"],
          "additionalProperties": false,
          "properties": {
            "mode": { "const": "deboss" },
            "depth": { "type": "number", "exclusiveMinimum": 0 }
          }
        },
        {
          "type": "object",
          "required": ["mode", "depth"],
          "additionalProperties": false,
          "properties": {
            "mode": { "const": "flush" },
            "depth": { "type": "number", "exclusiveMinimum": 0 }
          }
        },
        {
          "type": "object",
          "required": ["mode"],
          "additionalProperties": false,
          "properties": {
            "mode": { "const": "cut" }
          }
        },
        {
          "type": "object",
          "required": ["mode", "depth", "floorMaterial", "floorThickness"],
          "additionalProperties": false,
          "properties": {
            "mode": { "const": "deboss-backed" },
            "depth": { "type": "number", "exclusiveMinimum": 0 },
            "floorMaterial": { "type": "string", "minLength": 1 },
            "floorThickness": { "type": "number", "exclusiveMinimum": 0 }
          }
        }
      ]
    },
    "font": {
      "type": "object",
      "required": ["family", "size"],
      "additionalProperties": false,
      "properties": {
        "family": { "type": "string", "minLength": 1 },
        "size": { "type": "number", "exclusiveMinimum": 0 },
        "weight": { "type": "number", "minimum": 1, "maximum": 1000 },
        "italic": { "type": "boolean" },
        "axes": {
          "type": "object",
          "additionalProperties": { "type": "number" }
        }
      }
    },
    "featureBase": {
      "type": "object",
      "required": ["id", "type", "transform", "material", "relief"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "enum": ["text-block", "text-pattern", "pattern", "qr", "icon", "shape", "hole", "pocket"] },
        "name": { "type": "string" },
        "transform": { "$ref": "#/$defs/transform" },
        "material": { "type": "string", "minLength": 1 },
        "relief": { "$ref": "#/$defs/relief" },
        "zOrder": { "type": "integer" },
        "visible": { "type": "boolean" },
        "backing": { "$ref": "#/$defs/backing" }
      }
    },
    "feature": {
      "allOf": [
        { "$ref": "#/$defs/featureBase" },
        {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "type": { "const": "text-block" },
                "lines": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
                "font": { "$ref": "#/$defs/font" },
                "align": { "enum": ["left", "center", "right"] },
                "lineHeight": { "type": "number", "exclusiveMinimum": 0 }
              },
              "required": ["type", "lines", "font"]
            },
            {
              "type": "object",
              "properties": {
                "type": { "const": "text-pattern" },
                "text": { "type": "string", "minLength": 1 },
                "font": { "$ref": "#/$defs/font" },
                "spacing": { "type": "number", "exclusiveMinimum": 0 },
                "spacingY": { "type": "number", "exclusiveMinimum": 0 },
                "angle": { "type": "number" }
              },
              "required": ["type", "text", "font", "spacing"]
            },
            {
              "type": "object",
              "properties": {
                "type": { "const": "pattern" },
                "patternType": { "enum": ["dots", "lines", "grid", "hex", "svg"] },
                "spacing": { "type": "number", "exclusiveMinimum": 0 },
                "spacingY": { "type": "number", "exclusiveMinimum": 0 },
                "angle": { "type": "number" },
                "elementSize": { "type": "number", "exclusiveMinimum": 0 },
                "region": { "enum": ["face", "bounds"] },
                "width": { "type": "number", "exclusiveMinimum": 0 },
                "height": { "type": "number", "exclusiveMinimum": 0 },
                "svgInline": { "type": "string" },
                "colorMap": { "type": "object", "additionalProperties": { "type": "string" } }
              },
              "required": ["type", "patternType", "spacing"]
            },
            {
              "type": "object",
              "properties": {
                "type": { "const": "qr" },
                "qrType": { "enum": ["url", "vcard", "wifi", "email", "text"] },
                "fields": {
                  "type": "object",
                  "additionalProperties": { "type": "string" }
                },
                "size": { "type": "number", "exclusiveMinimum": 0 },
                "errorCorrection": { "enum": ["L", "M", "Q", "H"] },
                "quietZone": { "type": "number", "minimum": 0 }
              },
              "required": ["type", "qrType", "fields", "size"]
            },
            {
              "type": "object",
              "properties": {
                "type": { "const": "icon" },
                "svgAsset": { "type": "string" },
                "svgInline": { "type": "string" },
                "width": { "type": "number", "exclusiveMinimum": 0 },
                "height": { "type": "number", "exclusiveMinimum": 0 },
                "colorMap": {
                  "type": "object",
                  "additionalProperties": { "type": "string" }
                }
              },
              "required": ["type", "width"]
            },
            {
              "type": "object",
              "properties": {
                "type": { "const": "shape" },
                "shapeType": { "enum": ["rect", "rounded-rect", "circle", "ring", "frame", "corner-marks", "path"] },
                "width": { "type": "number", "exclusiveMinimum": 0 },
                "height": { "type": "number", "exclusiveMinimum": 0 },
                "radius": { "type": "number", "minimum": 0 },
                "diameter": { "type": "number", "exclusiveMinimum": 0 },
                "strokeWidth": { "type": "number", "exclusiveMinimum": 0 },
                "inset": { "type": "number", "minimum": 0 },
                "length": { "type": "number", "exclusiveMinimum": 0 },
                "svgPath": { "type": "string" }
              },
              "required": ["type", "shapeType"]
            },
            {
              "type": "object",
              "properties": {
                "type": { "const": "hole" },
                "holeType": { "enum": ["circle", "slot"] },
                "diameter": { "type": "number", "exclusiveMinimum": 0 },
                "width": { "type": "number", "exclusiveMinimum": 0 },
                "height": { "type": "number", "exclusiveMinimum": 0 },
                "tab": { "type": "boolean" },
                "tabMargin": { "type": "number", "exclusiveMinimum": 0 }
              },
              "required": ["type", "holeType"]
            },
            {
              "type": "object",
              "description": "Blind cavity sized to hold an insert (magnet, RFID/NFC tag). diameter/depth are the insert's nominal size; the cavity cut is (diameter + clearance) x (depth + depthClearance). relief is ignored — the pocket owns its own z geometry — and so is transform.scale: the bore is measured from the insert, and scaling it would widen the bore while leaving the depth alone. Resize a pocket by changing diameter.",
              "properties": {
                "type": { "const": "pocket" },
                "pocketType": { "enum": ["circle"] },
                "insert": {
                  "enum": ["magnet", "rfid", "other"],
                  "description": "What goes in it. A label for the build notes — it has no effect on geometry."
                },
                "diameter": {
                  "type": "number", "exclusiveMinimum": 0,
                  "description": "Nominal insert diameter (mm), before clearance."
                },
                "depth": {
                  "type": "number", "exclusiveMinimum": 0,
                  "description": "Nominal insert thickness (mm), before depthClearance."
                },
                "clearance": {
                  "type": "number", "minimum": 0,
                  "description": "Diametral slack (mm) added to diameter. Omitted = 0.2."
                },
                "depthClearance": {
                  "type": "number", "minimum": 0,
                  "description": "Slack (mm) added to depth. Omitted = 0.1."
                },
                "ceiling": {
                  "type": "number", "minimum": 0,
                  "description": "Lid left over the cavity (mm), measured from the face. 0 = open at the surface; anything else buries the insert and the print must be paused to drop it in."
                }
              },
              "required": ["type", "pocketType", "diameter", "depth"]
            }
          ]
        }
      ]
    }
  }
}
